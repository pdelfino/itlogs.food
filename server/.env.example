ITLOGS_PROVIDER=fake            # fake | meta
MODEL_API_KEY=                  # Meta Model API key: from the environment, never in the repo
ITLOGS_META_API_BASE=https://api.meta.ai/v1
ITLOGS_VISION=meta              # meta (Muse Spark) | baseten (Muse Spark Open on Baseten) | local (Muse Glimmer on llama-server); the last two are the open-weight paths
ITLOGS_LLM=meta                 # meta (Muse Spark) | baseten (Muse Spark Open) | local (llama-server)
BASETEN_API_KEY=
ITLOGS_USUAL_FOODS=cooked white rice,chicken breast,egg whites,canned pumpkin,oats,banana   # checked first by the reader
ITLOGS_BOWL=1                            # 0: a bowl takes the bare-food path, each rise is not its own row
ITLOGS_SECOND_READ_AFTER_MS=1500         # the second look this long after the first
ITLOGS_GRAMS_TOLERANCE_G=1.0             # two reads agree when the grams differ by at most this
ITLOGS_RECORD_DIR=                       # set to keep the frames that were read and the entries (a local folder, never git)
ITLOGS_POSTHOG_TOKEN=                    # PostHog project token (public, write-only); empty = telemetry off; also feeds make ios-gen
ITLOGS_POSTHOG_HOST=https://us.i.posthog.com
